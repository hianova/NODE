; NODE v1.0.0 — Pure QF_LIA BFT 3f+1 Quorum Intersection & DBSP Z-Set Overflow Bounds
(set-logic QF_LIA)

(declare-const f Int) (declare-const n Int)
(declare-const q1 Int) (declare-const q2 Int) (declare-const inter Int)

; CHECK 1: Anti-vacuity for BFT N = 3f + 1 quorum system (expect SAT)
(push)
(assert (>= f 1))
(assert (= n (+ (* 3 f) 1)))
(assert (>= q1 (+ (* 2 f) 1)))
(assert (>= q2 (+ (* 2 f) 1)))
(assert (<= q1 n))
(assert (<= q2 n))
(check-sat)
(pop)

; CHECK 2: BFT 3f+1 quorum intersection >= f + 1 honest guarantee (expect UNSAT)
(push)
(assert (>= f 1))
(assert (= n (+ (* 3 f) 1)))
(assert (>= q1 (+ (* 2 f) 1)))
(assert (>= q2 (+ (* 2 f) 1)))
(assert (>= inter (- (+ q1 q2) n)))
(assert (<= inter f))
(check-sat)
(pop)

; CHECK 3: Honest Theory Falsification — under-provisioned N = 3f admits all-Byzantine intersection <= f (expect SAT)
(push)
(assert (>= f 1))
(assert (= n (* 3 f)))
(assert (= q1 (* 2 f)))
(assert (= q2 (* 2 f)))
(assert (= inter (- (+ q1 q2) n)))
(assert (<= inter f))
(check-sat)
(pop)

; CHECK 4: DBSP Z-Set bounded weight addition fits without overflow (expect UNSAT)
(declare-const w_a Int) (declare-const w_b Int)
(push)
(assert (and (>= w_a (- 1073741823)) (<= w_a 1073741823)))
(assert (and (>= w_b (- 1073741823)) (<= w_b 1073741823)))
(assert (or (< (+ w_a w_b) (- 2147483646)) (> (+ w_a w_b) 2147483646)))
(check-sat)
(pop)
